NODE_ENV=production
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@SESSION_POOLER_HOST:5432/postgres?sslmode=verify-full
# Append &sslrootcert=/absolute/path/certificates/supabase-ca.crt for Supabase's private CA.
# Optional direct/session URL for Prisma CLI if runtime uses a transaction pooler:
# DIRECT_URL=postgresql://...
PORT=4000
HOST=127.0.0.1
WEB_ORIGINS=https://YOUR_APPROVED_DOMAIN
FIREBASE_PROJECT_ID=geki-academy
# Optional one-time owner invitation; only a verified Firebase email can accept it.
# BOOTSTRAP_OWNER_EMAIL=your-owner@example.com
GOOGLE_APPLICATION_CREDENTIALS=/absolute/private/path/firebase-admin.json
# Set false only for standard signed-token verification without privileged Admin access.
# In that mode Firebase revocations take effect at token expiry; DB suspensions apply immediately.
FIREBASE_CHECK_REVOKED=true
# Do not set FIREBASE_AUTH_EMULATOR_HOST in production.
MEDIA_MODE=disabled
# Private source uploads and admin previews work independently from paid streaming.
# Use a persistent, private volume when deploying the API:
UPLOAD_DIR=.local/uploads
# Set a random persistent secret when running multiple API instances:
# MEDIA_TICKET_SECRET=
# Optional adapter, only after selecting and validating the provider:
# MEDIA_MODE=vdocipher
# VDOCIPHER_API_SECRET=

# Server-only private payment receipt storage. Never use NEXT_PUBLIC_ for the key.
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SECRET_KEY=""
