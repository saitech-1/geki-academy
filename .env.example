# Local development only. Use a managed PostgreSQL connection in production.
DATABASE_URL=postgresql://geki:geki_local_only@127.0.0.1:5433/geki
PORT=3000
WEB_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
FIREBASE_PROJECT_ID=demo-geki-academy
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# Production: unset emulator host; use application default credentials or a private key file outside the repo.
# GOOGLE_APPLICATION_CREDENTIALS=/secure/path/to/service-account.json
# Cloud API: DATABASE_SSL_CA may contain the PEM from certificates/supabase-ca.crt.
# This replaces machine-specific SSL certificate paths without disabling verification.
# Explicitly development-only uploads; production premium content requires a configured DRM provider.
MEDIA_MODE=local
UPLOAD_DIR=.local/uploads
# Optional VdoCipher integration. No provider purchase is assumed.
# MEDIA_MODE=vdocipher
# VDOCIPHER_API_SECRET=


NEXT_PUBLIC_FIREBASE_API_KEY=demo-local-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-geki-academy.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-geki-academy
NEXT_PUBLIC_FIREBASE_APP_ID=demo-geki-web
# Set only for local Next.js development; never in a production build.
NEXT_PUBLIC_AUTH_EMULATOR_URL=http://127.0.0.1:9099
