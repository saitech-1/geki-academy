{
  "name": "geki-academy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3000",
    "dev:all": "concurrently -k -n postgres,auth,app \"npm run db:local\" \"npm run auth:emulator\" \"npm run dev\"",
    "db:local": "tsx scripts/local-postgres.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy && tsx scripts/secure-database.ts",
    "db:seed": "tsx scripts/seed.ts",
    "auth:emulator": "node scripts/auth-emulator.mjs",
    "setup:local": "tsx scripts/setup-local.ts",
    "admin:grant": "tsx scripts/grant-admin.ts",
    "typecheck": "tsc --noEmit",
    "build": "npm run db:generate && next build",
    "test": "vitest run",
    "test:integration": "tsx scripts/integration-test.ts",
    "test:reminders": "tsx scripts/reminders-integration.ts",
    "test:admin": "node scripts/browser-check.cjs && tsx scripts/admin-crud-test.ts && node scripts/admin-browser.cjs",
    "test:owner": "tsx scripts/owner-invitation-test.ts",
    "test:browser": "node scripts/browser-check.cjs && npm run test:integration && node scripts/browser-learning.cjs",
    "check:live-db": "node scripts/check-live-db.mjs",
    "reminders:once": "tsx scripts/membership-reminders.ts --once",
    "reminders:worker": "tsx scripts/membership-reminders.ts",
    "db:migrate:live": "node --env-file=.env.migrations.local node_modules/prisma/build/index.js migrate deploy && node --env-file=.env.migrations.local --import tsx scripts/secure-database.ts",
    "start:reminders:live": "node --env-file=.env.production.local --import tsx scripts/membership-reminders.ts",
    "test:payments": "tsx scripts/qr-payments-test.ts",
    "test:ci": "node scripts/ci-integration.mjs",
    "build:verified": "npm run db:generate && npm run test:auth-runtime && npm run typecheck && npm test && next build",
    "start": "next start --hostname 0.0.0.0 --port 3000",
    "start:live": "node --env-file=.env.production.local node_modules/next/dist/bin/next start --hostname 0.0.0.0 --port 3000",
    "test:auth-runtime": "node --no-experimental-require-module scripts/auth-runtime-check.cjs",
    "test:hydration": "node scripts/hydration-browser.cjs",
    "test:localization": "node scripts/localization-browser.cjs",
    "test:preview": "node scripts/production-preview-check.cjs"
  },
  "dependencies": {
    "@geki/contracts": "*",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@supabase/supabase-js": "2.118.0",
    "@tailwindcss/postcss": "4.3.3",
    "busboy": "1.6.0",
    "dotenv": "17.2.3",
    "firebase": "13.0.0",
    "firebase-admin": "14.5.0",
    "lucide-react": "^0.468.0",
    "next": "16.4.2",
    "pg": "8.16.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "4.3.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/busboy": "^1.5.4",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "concurrently": "^9.2.0",
    "embedded-postgres": "18.4.0-beta.17",
    "firebase-tools": "15.34.0",
    "playwright": "1.58.2",
    "prettier": "^3.6.2",
    "prisma": "7.10.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  },
  "optionalDependencies": {
    "@embedded-postgres/windows-x64": "18.4.0-beta.17"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.6",
    "jwks-rsa": {
      "jose": "5.10.0"
    }
  }
}
